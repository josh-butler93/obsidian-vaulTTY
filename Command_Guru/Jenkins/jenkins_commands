#Jenkins Reload Script

#!/bin/bash
set -e

COOKIE_JAR=/tmp/jenkins-webhook-lab.cookies
CRUMB=$(curl -fsS -c "$COOKIE_JAR" 'http://localhost:8080/crumbIssuer/api/xml?xpath=concat(//crumbRequestField,":",//crumb)')
curl -fsS -b "$COOKIE_JAR" -H "$CRUMB" -X POST http://localhost:8080/reload >/dev/null || true

for i in {1..30}; do
  if curl -fsS http://localhost:8080/api/json >/dev/null 2>&1; then
    exit 0
  fi
  sleep 2
done

echo "Jenkins did not become ready after reload" >&2
exit 1
