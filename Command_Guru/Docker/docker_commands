 --how many unique ports are published on the container
 	* docker ps

 --which port is mapped on the container side
 	* docker ps
		--the ports column format is hostPort->containerPort --the value after the -> in the container internal port

 --which of the below ports are published on the Host
 	* docker ps 
		--ports on the left (before ->) are publisded on the host

 --run an instance of the kodekcloud/simple-webapp:blue with the name blue-app mapping port 8080 on the container to port 38282 on the host
 	* docker run -d -p 38282:8080 --name blue-app kodekloud/simple-webapp:blue  
		--hostPort:containerPort

