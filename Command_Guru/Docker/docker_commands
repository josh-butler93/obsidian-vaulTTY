#Running a Docker Container
	* sudo dnf config-manager --add-repo https://docker.com
	* sudo dnf install -y docker-ce-cli containerd.io docker-compose-plugin
	* sudo systemctl enable --now docker
	* sudo systemctl start docker
	* sudo usermod -aG docker $USER || newgrp docker
	* sudo dnf config-manager --add-repo https://download.docker.com/linux/rhel/docker-ce.repo
	* sudo sed -i 's/\$releasever/9/g' /etc/yum.repos.d/docker-ce.repo
	* sudo dnf install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin
	* docker version
	* docker run <container_name>
	* docker ps
	* docker ps -a
	* docker ps --filter name=jenkins --format 'name={{.Names}} image={{.Image}} status={{.Status}} ports={{.Ports}}'
	* docker ps --filter name=jenkins --format 'name={{.Names}} image={{.Image}} status={{.Status}} ports={{.Ports}}' > jenkins-docker-report.txt
	* docker ps --filter name=jenkins-init-lab --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'
	* docker images
	* docker images <repo_name>
	* docker images jenkins/jenkins
	* docker start <container_name>
	* docker restart nginx-detached
	* docker stop <container_name>
	* docker stop $(docker ps -aq)
	* docker rm <container_name>
	* docker rm $(docker ps -aq)
	* docker rmi <image_name>
	* docker rmi redis
	* docker rmi $(docker images -aq)
	* docker run ubuntu sleep 5
	* docker run -d --name my-webapp -p 8080:80 nginx
		--curl http://localhost:8080
	* docker run -d --name=grafana -p 3000:3000 grafana/grafana
	* docker run --name webapp nginx:1.14-alpine
	* docker run -d -p 38282:8080 --name webapp kodecloud/simple:webapp:blue
		* docker port webapp
	* docker run -p 38282:8989 --name blue-app -e APP_COLOR=blue -d kodekloud/simple-webapp
	* docker run --name mysql-db -e MYSQL_ROOT_PASSWORD=db_pass123 mysql
	* docker run --rm python:latest python --version --the '--rm' tells docker to remove the container after it exits
  * docker run -it --name ubuntu-interactive ubunut /bin/bash or bash
	* docker port <container_name>
	* docker port dockhand --this command will show port mappings for the machine
	* docker exec jenkins ls /var/jenkins_home
	* docker inspect container_name 
	* docker inspect webapp 
	* docker inspect webapp | grep ...
	* docker inspect <image_name> --format '{{.Config.Image}}'
	* docker inspect jenkins --format '{{.Config.Image}}'
	* docker inspect jenkins --format '{{range .Mounts}}{{.Source}} -> {{.Destination}}{{println}}{{end}}' > jenkins-docker-report.txt
	* docker inspect --format='{{.RootFS.Layers}}' nginx
	* docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAdress}}{{end}}' nginx-detached
	* docker inspect -f '{{.State.Status}}' nginx-detached
	* docker build -t webapp-color .
	* docker build -t webapp-color:lite . 
	* docker logs big-bear-coolify --tail 50
	* docker logs --tail 59 jenkins
	* docker logs --tail 10 nginx-detached
	* docker logs -f nginx-detached --this will follow the logs in real time
	* docker logs --timestamps nginx-detached
	* docker build -t custom-nginx .
	* docker search nginx --this will return a list of images related to nginx
	* docker save nginx > nginx.tar --this command saves the Nginx image to a file named nginx.tar 
		* docker load < nginx.tar
			* docker images nginx
	* docker tag nginx:latest my-nginx:v1
		--nginx:latest= is the source image and tag
		--my-nginx= is the new image name we're creating
		--v1= is the new tag we're assigning 
			* docker run -d --name my-nginx-container my-nginx
				--'-d'= runs the container in detached mode (in the background)
				--'--name my-nginx-contianer'= gives a name to the new container
				--my-nginx:v1= is the image and tag we're using to create the container
					* docker logs my-nginx-container

#Executing Commands on a running container
	* docker exec <container_name> cat /etc/os-release


