FROM nginx
ENV NGINX_PORT 9000
RUN sed -i "s/listen[[:space:]]*80;/listen $NGINX_PORT;/g" /etc/nginx/conf.d/default.conf
COPY index.html /usr/share/nginx/html/


ENV NGINX_PORT 9000: This sets an environment variable NGINX_PORT with the value 9000.

RUN sed -i "s/listen[[:space:]]*80;/listen $NGINX_PORT;/g" /etc/nginx/conf.d/default.conf: This uses sed to replace the default port (80) with our environment variable in the Nginx configuration file

	* docker build -t my-nginx-env .
	* docker run -d -p 9000:9000 --name env-container my-nginx-env
	* curl http://localhost:9000
