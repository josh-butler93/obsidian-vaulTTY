# KVM VM Configuration
# Rename to kvm.tfvars and adjust values as needed

kvm_defaults = {
  node            = "pve"
  template_vm_id = 9000
  storage        = "local"
  pool           = "vms"
  network_bridge = "vmbr0"
}

kvm_vms = [
  {
    vmid      = 101
    name      = "web-server-01"
    on_boot   = true
    cores     = 2
    memory    = 2048
    disk_size = 20
    # cloud-init (optional)
    # ipconfig  = "ip=192.168.1.101/24,gw=192.168.1.1"
    # ssh_keys  = ["/root/.ssh/authorized_keys"]
    # ciuser    = "admin"
    # cipass   = "changeme"
  },
  {
    vmid      = 102
    name      = "web-server-02"
    on_boot   = true
    cores     = 2
    memory    = 2048
    disk_size = 20
  },
]