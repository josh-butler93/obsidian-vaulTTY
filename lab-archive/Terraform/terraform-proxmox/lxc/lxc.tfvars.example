# LXC Container Configuration
# Rename to lxc.tfvars and adjust values as needed

lxc_defaults = {
  node            = "pve"
  template_ct_id = 9000
  storage        = "local"
  pool           = "vms"
  network_bridge = "vmbr0"
}

lxc_containers = [
  {
    vmid      = 201
    name      = "nginx-01"
    hostname = "nginx-01"
    on_boot   = true
    cores     = 1
    memory    = 512
    rootfs    = 2
    swap      = 256
    ostype    = "debian"
    # network config (optional)
    # netif = [{ name = "eth0", bridge = "vmbr0" }]
    # ipconfig = [{ ip = "192.168.1.201/24", gw = "192.168.1.1" }]
  },
  {
    vmid      = 202
    name      = "nginx-02"
    hostname = "nginx-02"
    on_boot   = true
    cores     = 1
    memory    = 512
    rootfs    = 2
    swap      = 256
    ostype    = "debian"
  },
]